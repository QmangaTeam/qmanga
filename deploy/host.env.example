# Copy to /opt/qmanga/config/staging.env or production.env; chmod 600.
# Use independent random hex values for each environment. Never commit real values.
DEPLOY_TARGET=staging
APP_ORIGIN=https://qmanga-dev.maqsatto.dev
IMAGE_PREFIX=ghcr.io/maqsatto/qmanga
POSTGRES_PASSWORD=replace_with_random_hex
MINIO_ROOT_USER=qmanga_root_replace_with_random_hex
MINIO_ROOT_PASSWORD=replace_with_random_hex
S3_ACCESS_KEY=qmanga_app_replace_with_random_hex
S3_SECRET_KEY=replace_with_random_hex
SESSION_SECRET=replace_with_random_hex
CSRF_SECRET=replace_with_random_hex
SMTP_ADDRESS=smtp.example.net:587
SMTP_FROM=no-reply@maqsatto.dev
SMTP_USERNAME=
SMTP_PASSWORD=
