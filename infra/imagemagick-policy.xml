<policymap>
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="time" value="240"/>
  <policy domain="resource" name="memory" value="128MiB"/>
  <policy domain="resource" name="map" value="0"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="width" value="100KP"/>
  <policy domain="resource" name="height" value="100KP"/>
  <policy domain="resource" name="list-length" value="64"/>
