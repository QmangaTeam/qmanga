{
  "name": "qmanga-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:architecture": "bun scripts/check-boundaries.mjs",
    "check:ui-contrast": "bun scripts/check-ui-contrast.mjs",
    "test:ui": "bun test --preload ./tests/ui/setup.ts ./tests/ui",
    "ui:preview": "svelte-kit sync && vite --config vite.ui-preview.config.ts",
    "check:ui-preview": "svelte-check --tsconfig ./tsconfig.ui-preview.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.17.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
